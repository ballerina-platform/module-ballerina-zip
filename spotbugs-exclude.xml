<FindBugsFilter>
    <!--
      The null that `read` returns says the entry is exhausted, which the stream on the Ballerina
      side turns into the nil that ends it. A zero length array is a chunk like any other, so
      returning one instead would leave the stream never ending.
    -->
    <Match>
        <Class name="io.ballerina.lib.zip.nativeimpl.EntryStream"/>
        <Method name="read"/>
        <Bug pattern="PZLA_PREFER_ZERO_LENGTH_ARRAYS"/>
    </Match>
</FindBugsFilter>
